{
  "name": "retirement-planning-calculator",
  "version": "1.0.0",
  "type": "module",
  "description": "A retirement withdrawal calculator and backtesting toolkit.",
  "scripts": {
    "prebuild": "node scripts/inline-worker.mjs",
    "build": "vite build",
    "build:prod": "npm-run-all data:refresh build",
    "dev": "npm run build && vite preview --host 127.0.0.1 --port 8080 --strictPort",
    "dev:watch": "npm run build && npm-run-all --parallel watch preview:8080",
    "watch": "vite build --watch",
    "preview:8080": "vite preview --host 127.0.0.1 --port 8080 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "data:refresh": ".venv/bin/python collect_market_data.py --refresh",
    "data:smoke": ".venv/bin/python collect_market_data.py --only sp500_price cpi_us --refresh",
    "check:python": ".venv/bin/python -m py_compile collect_market_data.py build_dataset.py retirement_optimizer.py",
    "check:json": "node tests/check-data-sources.mjs",
    "check:version": "node -e \"import('./scripts/version-utils.mjs').then(({parseVersion})=>parseVersion(require('node:fs').readFileSync('VERSION','utf8')))\"",
    "check:html": "html-validate --config .htmlvalidate.json index.html",
    "check:js": "node tests/check-scripts.mjs",
    "lint": "eslint scripts tests src",
    "test:unit": "vitest run",
    "test:a11y": "npm run build && sh -c 'npm run preview > /tmp/retirement-vite-preview.log 2>&1 & PREVIEW_PID=$!; wait-on http://127.0.0.1:4173; node tests/a11y.mjs; STATUS=$?; kill $PREVIEW_PID 2>/dev/null || true; exit $STATUS'",
    "test": "npm-run-all check:version check:json check:js check:python lint test:unit test:a11y"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@sentry/browser": "^10.53.1",
    "alpinejs": "^3.15.12",
    "chart.js": "^4.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "axe-core": "^4.11.4",
    "eslint": "^10.4.0",
    "html-validate": "^11.2.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^8.0.4",
    "playwright": "^1.60.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "wait-on": "^9.0.10"
  }
}
